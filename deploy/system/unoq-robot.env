# /etc/default/unoq-robot
#
# 应用目录与端口只在这里定义一次。看门狗脚本与 systemd 单元都读这个文件，
# 所以换安装目录、改项目名都不需要改代码。
#
#   sudo cp deploy/system/unoq-robot.env /etc/default/unoq-robot
#   sudo systemctl daemon-reload

APP_DIR=/home/arduino/ArduinoApps/uno-q-ros2-demo
PORT=7000

# 看门狗调参（一般不用改）
# POLL_S=5          轮询周期，秒
# STALE_LIMIT=3     连续多少次序列号不前进判定失联
# GRACE_S=120       启动宽限期，覆盖编译烧录
# COOLDOWN_S=180    两次恢复之间的最小间隔
